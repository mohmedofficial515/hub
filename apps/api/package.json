    "jose": "^6.2.15",
    "nestjs-cls": "^6.3.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "5.5.0",
    "nodemailer": "^8.0.11",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
