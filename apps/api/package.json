  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:arch": "jest test/arch",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrations:check": "node scripts/check-migrations.mjs",
    "seed:owner": "node -r ./scripts/swc-register.cjs scripts/seed-owner.ts",
    "seed:sources": "node -r ./scripts/swc-register.cjs scripts/seed-local-sources.ts",
    "import:goteav": "node -r ./scripts/swc-register.cjs scripts/import-goteav.ts",
    "openapi:export": "node -r ./scripts/swc-register.cjs scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hub/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
