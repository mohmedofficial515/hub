<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td class="pad" style="padding:30px 32px 6px;">
  <h1 class="h1 ink" style="margin:0 0 12px;font-size:40px;line-height:1.2;font-weight:800;color:#1f325c;text-align:{{textStart}};">{{t 'emails.design.headline' city=outboundCity}}</h1>
  <p class="ink" style="margin:0;font-size:16px;line-height:1.7;color:#2b3a55;text-align:{{textStart}};">{{#if firstName}}{{t 'emails.layout.greeting' name=firstName}}{{else}}{{t 'emails.layout.greeting_anonymous'}}{{/if}} {{t 'emails.bookings.confirmed.body' siteName=siteName reference=reference}}</p>
</td>
</tr>

<!-- The memorable thing: this email is one stop on the trip's track. Every template lights a different stop. -->
<tr>
<td class="pad" style="padding:28px 24px 8px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    {{> stage state='done' first=true label=(t 'emails.design.stage_paid')}}
    {{> stage state='now' label=(t 'emails.design.stage_confirmed')}}
    {{> stage state='todo' label=(t 'emails.design.stage_ticket')}}
    {{> stage state='todo' last=true label=(t 'emails.design.stage_fly')}}
  </tr>
  </table>
</td>
</tr>

<tr>
<td class="pad" style="padding:14px 32px 8px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td class="next" bgcolor="#eef5f6" style="background-color:#eef5f6;border-radius:12px;padding:16px 18px;text-align:{{textStart}};">
    <div class="ink" style="font-size:15px;font-weight:800;color:#1f325c;">{{t 'emails.design.next_title'}}</div>
    <div class="ink" style="margin-top:3px;font-size:14px;line-height:1.65;color:#2b3a55;">{{t 'emails.bookings.confirmed.ticket_soon'}}</div>
  </td></tr>
  </table>
</td>
</tr>

<tr>
<td class="pad" style="padding:22px 32px 4px;">
  {{#each slices}}
  <table role="presentation" class="rule" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e4e9ee;">
  <tr>
    <td style="padding:16px 0;vertical-align:top;text-align:{{@root.textStart}};">
      <div class="ink" dir="ltr" style="font-size:22px;font-weight:800;line-height:1.25;color:#1f325c;text-align:{{@root.textStart}};">{{clock departingAt}} <span style="font-weight:600;">{{origin}}</span></div>
      <div class="muted" style="margin-top:2px;font-size:13px;color:#5b6a7e;">{{day departingAt}}</div>
    </td>
    <td width="44" align="center" class="muted" style="width:44px;padding:16px 0;vertical-align:top;font-size:20px;line-height:1.4;color:#5b6a7e;text-align:center;">{{t 'emails.design.arrow'}}</td>
    <td style="padding:16px 0;vertical-align:top;text-align:{{@root.textEnd}};">
      <div class="ink" dir="ltr" style="font-size:22px;font-weight:800;line-height:1.25;color:#1f325c;text-align:{{@root.textEnd}};">{{clock arrivingAt}} <span style="font-weight:600;">{{destination}}</span></div>
      <div class="muted" dir="ltr" style="margin-top:2px;font-size:13px;color:#5b6a7e;text-align:{{@root.textEnd}};">{{#each flights}}{{this}}{{#unless @last}} / {{/unless}}{{/each}}</div>
    </td>
  </tr>
  </table>
  {{/each}}
  <table role="presentation" class="rule" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e4e9ee;">
  {{#if pnr}}{{> fact label=(t 'emails.bookings.confirmed.pnr') value=pnr ltr=true strong=true}}{{/if}}
  {{> fact label=(t 'emails.bookings.confirmed.reference') value=reference ltr=true}}
  {{#if airline}}{{> fact label=(t 'emails.bookings.confirmed.airline') value=airline}}{{/if}}
  <tr>
    <td class="muted" style="padding:9px 0;vertical-align:top;font-size:14px;color:#5b6a7e;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.passengers'}}</td>
    <td class="ink" dir="ltr" style="padding:9px 0;vertical-align:top;font-size:14px;font-weight:600;line-height:1.6;color:#1f2a44;text-align:{{textEnd}};">{{#each passengers}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</td>
  </tr>
  {{#if amount}}{{> fact label=(t 'emails.bookings.confirmed.total') value=amount suffix=currency ltr=true}}{{/if}}
  </table>
</td>
</tr>

<tr>
<td class="pad" style="padding:18px 32px 30px;">
  {{> button url=link label=(t 'emails.bookings.confirmed.cta')}}
  {{> link_fallback url=link}}
  {{> signature}}
</td>
</tr>
</table>
