<tr>
  <td class="muted" style="padding:9px 0;vertical-align:top;font-size:14px;color:#5b6a7e;text-align:{{@root.textStart}};">{{label}}</td>
  <td class="ink" {{#if ltr}}dir="ltr"{{/if}} style="padding:9px 0;vertical-align:top;font-size:{{#if strong}}20px{{else}}15px{{/if}};font-weight:{{#if strong}}800{{else}}600{{/if}};color:#1f2a44;text-align:{{@root.textEnd}};">{{value}}{{#if suffix}} {{suffix}}{{/if}}</td>
</tr>
