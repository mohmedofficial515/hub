<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{subject}}</title>
<style>
@media (max-width:600px) {
  .pad { padding-left:20px !important; padding-right:20px !important; }
  .h1 { font-size:32px !important; }
  .stage { font-size:12px !important; }
}
@media (prefers-color-scheme: dark) {
  .page { background-color:#0f172b !important; }
  .ink { color:#f1f5f9 !important; }
  .muted { color:#a9b6cb !important; }
  .rule { border-color:#2b3a59 !important; }
  .next { background-color:#1a2743 !important; }
  .todo-line { background-color:#34435f !important; }
  .todo-node { background-color:#0f172b !important; border-color:#51627f !important; color:#a9b6cb !important; }
  .now-node { background-color:#2bc4c4 !important; color:#06202a !important; }
  .done-node, .done-line { background-color:#2bc4c4 !important; color:#06202a !important; }
  .link { color:#4fd1d1 !important; }
  .logo-light { display:none !important; }
  .logo-dark { display:inline-block !important; }
}
</style>
</head>
<body class="page" dir="{{dir}}" style="margin:0;padding:0;background-color:#ffffff;">
<div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#ffffff;">{{t 'emails.design.preheader'}}</div>
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background-color:#ffffff;">
<tr>
<td align="center" style="font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Helvetica,Arial,'Noto Sans Arabic',sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
<tr>
<td class="pad" dir="{{dir}}" style="padding:30px 32px 0;text-align:{{textStart}};">
<a href="{{url webUrl}}"><img class="logo-light" src="{{logoOnLight}}" height="28" alt="{{siteName}}" style="display:inline-block;height:28px;width:auto;border:0;color:#1f325c;font-size:18px;font-weight:700;"><!--[if !mso]><!--><img class="logo-dark" src="{{logoOnDark}}" height="28" alt="" style="display:none;height:28px;width:auto;border:0;"><!--<![endif]--></a>
</td>
</tr>
<tr><td dir="{{dir}}">{{{body}}}</td></tr>
<tr>
<td class="pad muted rule" dir="{{dir}}" style="padding:22px 32px 30px;border-top:1px solid #e4e9ee;font-size:13px;line-height:1.7;color:#5b6a7e;text-align:{{textStart}};">
<p style="margin:0 0 6px;">{{t 'emails.layout.support' supportEmail=supportEmail}}</p>
<p style="margin:0 0 6px;">{{t 'emails.layout.footer' siteName=siteName}}</p>
<p style="margin:0;">{{t 'emails.layout.rights' year=year siteName=siteName}}</p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
