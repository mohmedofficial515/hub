<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{subject}}</title>
<style>
@media (max-width:600px) {
  .outer { padding:14px 8px !important; }
  .pad { padding-left:20px !important; padding-right:20px !important; }
  .col { display:block !important; width:100% !important; box-sizing:border-box; border:0 !important; padding-left:0 !important; padding-right:0 !important; }
  .col-address { padding-top:18px !important; }
  .h1 { font-size:27px !important; }
}
@media (prefers-color-scheme: dark) {
  .desk { background-color:#07393d !important; }
  .card-paper { background-color:#e6efec !important; }
}
</style>
</head>
<body class="desk" dir="{{dir}}" style="margin:0;padding:0;background-color:#0b6f73;">
<div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#0b6f73;">{{t 'emails.design.preheader' city=outboundCity}}</div>
<table role="presentation" class="desk" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0b6f73" style="background-color:#0b6f73;">
<tr>
<td class="outer" align="center" style="padding:36px 16px;font-family:Georgia,'Sakkal Majalla','Traditional Arabic','Geeza Pro','Times New Roman',serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
<tr><td>{{{body}}}</td></tr>
<tr>
<td class="pad" dir="{{dir}}" style="padding:22px 28px 4px;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Helvetica,Arial,'Noto Sans Arabic',sans-serif;font-size:13px;line-height:1.7;color:#dcf3f1;text-align:{{textStart}};">
<p style="margin:0 0 6px;">{{t 'emails.layout.support' supportEmail=supportEmail}}</p>
<p style="margin:0 0 6px;">{{t 'emails.layout.footer' siteName=siteName}}</p>
<p style="margin:0;">{{t 'emails.layout.rights' year=year siteName=siteName}}</p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
