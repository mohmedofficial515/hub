<table role="presentation" class="card-paper" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f8f6" style="background-color:#f3f8f6;border-radius:6px;">
<!-- Top of the card: sender on one side; postmark and stamp on the other. -->
<tr>
<td class="pad" dir="{{dir}}" style="padding:26px 30px 8px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="vertical-align:top;text-align:{{textStart}};"><a href="{{url webUrl}}"><img src="{{logoOnLight}}" height="28" alt="{{siteName}}" style="display:inline-block;height:28px;width:auto;border:0;color:#1f325c;font-size:18px;font-weight:700;"></a></td>
    <td align="{{textEnd}}" style="vertical-align:top;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="{{textEnd}}">
      <tr>
        <td style="vertical-align:middle;padding:0 10px;">
          <!-- Postmark: tilts where the client allows it, sits straight where it does not. -->
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="transform:rotate(-11deg);">
          <tr><td align="center" width="82" height="82" style="width:82px;height:82px;border:3px double #1f325c;border-radius:50%;text-align:center;vertical-align:middle;color:#1f325c;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;">
            <div style="font-size:15px;font-weight:800;line-height:1.2;">{{t 'emails.design.status'}}</div>
            <div dir="ltr" style="margin-top:2px;font-size:10px;font-weight:700;">{{reference}}</div>
          </td></tr>
          </table>
        </td>
        <td style="vertical-align:top;">
          <!-- Stamp: dotted paper-coloured edge reads as perforation on the teal face. -->
          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" bgcolor="#067a7a" style="background-color:#067a7a;border:4px dotted #f3f8f6;outline:3px solid #067a7a;outline-offset:-3px;padding:12px 12px 10px;text-align:center;color:#ffffff;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;">
            <div dir="ltr" style="font-size:28px;line-height:1;font-weight:800;">{{slices.0.destination}}</div>
            <div style="margin-top:6px;font-size:12px;line-height:1.3;">{{outboundCity}}</div>
          </td></tr>
          </table>
        </td>
      </tr>
      </table>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- The classic split: the message on one side, the addressees on ruled lines on the other. -->
<tr>
<td class="pad" dir="{{dir}}" style="padding:12px 30px 22px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="col" width="56%" style="vertical-align:top;{{#if (eq dir 'rtl')}}padding-left:22px;border-left:1px solid #9fb6b4;{{else}}padding-right:22px;border-right:1px solid #9fb6b4;{{/if}}color:#1f2a44;text-align:{{textStart}};">
      <h1 class="h1" style="margin:0 0 12px;font-size:30px;line-height:1.25;font-weight:700;color:#1f325c;">{{t 'emails.design.headline' city=outboundCity}}</h1>
      {{> greeting}}
      <p style="margin:0 0 12px;font-size:18px;line-height:1.7;">{{t 'emails.bookings.confirmed.body' siteName=siteName reference=reference}}</p>
      <p style="margin:0 0 12px;font-size:18px;line-height:1.7;">{{t 'emails.bookings.confirmed.ticket_soon'}}</p>
      {{> signature}}
    </td>
    <td class="col col-address" width="44%" style="vertical-align:top;{{#if (eq dir 'rtl')}}padding-right:22px;{{else}}padding-left:22px;{{/if}}color:#1f2a44;text-align:{{textStart}};">
      <div style="margin-bottom:4px;font-size:16px;color:#4a5e66;">{{t 'emails.design.address_to'}}</div>
      {{#each passengers}}
      <div dir="ltr" style="padding:7px 0 5px;border-bottom:1px solid #9fb6b4;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;font-size:13px;font-weight:600;color:#1f325c;text-align:{{@root.textStart}};">{{this}}</div>
      {{/each}}
      {{#if pnr}}
      <div style="margin-top:16px;font-size:16px;color:#4a5e66;">{{t 'emails.bookings.confirmed.pnr'}}</div>
      <div dir="ltr" style="font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;font-size:24px;font-weight:800;letter-spacing:3px;color:#1f325c;text-align:{{textStart}};">{{pnr}}</div>
      {{/if}}
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- Itinerary strip, written like a travel diary rather than a data table. -->
<tr>
<td class="pad" dir="{{dir}}" bgcolor="#e2eeeb" style="background-color:#e2eeeb;padding:18px 30px;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;color:#1f2a44;">
  {{#each slices}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="{{#unless @last}}margin-bottom:12px;{{/unless}}">
  <tr>
    <td style="vertical-align:top;text-align:{{@root.textStart}};">
      <div style="font-size:15px;font-weight:700;"><span dir="ltr">{{origin}}</span> {{t 'emails.design.arrow'}} <span dir="ltr">{{destination}}</span></div>
      <div style="font-size:13px;color:#3e515a;">{{day departingAt}}</div>
    </td>
    <td dir="ltr" style="vertical-align:top;font-size:15px;font-weight:700;text-align:{{@root.textEnd}};">{{clock departingAt}}<div style="font-size:13px;font-weight:400;color:#3e515a;">{{#each flights}}{{this}}{{#unless @last}} / {{/unless}}{{/each}}</div></td>
  </tr>
  </table>
  {{/each}}
  {{#if amount}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;border-top:1px solid #b5cbc7;">
  <tr>
    <td style="padding-top:10px;font-size:13px;color:#3e515a;text-align:{{textStart}};">{{#if airline}}{{airline}}{{/if}}</td>
    <td style="padding-top:10px;font-size:13px;color:#3e515a;text-align:{{textEnd}};">{{t 'emails.bookings.confirmed.total'}} <strong dir="ltr" style="font-size:15px;color:#1f2a44;">{{amount}} {{currency}}</strong></td>
  </tr>
  </table>
  {{/if}}
</td>
</tr>

<tr>
<td class="pad" dir="{{dir}}" style="padding:22px 30px 24px;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Arial,sans-serif;">
  {{> button url=link label=(t 'emails.bookings.confirmed.cta')}}
  {{> link_fallback url=link}}
</td>
</tr>
</table>
