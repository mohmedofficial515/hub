<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td class="pad" style="padding:30px 32px 8px;">
  {{> greeting}}
  <h1 class="h1" style="margin:0 0 8px;font-size:30px;line-height:1.3;font-weight:800;color:#ffffff;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.title'}}</h1>
  <p style="margin:0;font-size:15px;line-height:1.7;color:#c4cee3;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.body' siteName=siteName reference=reference}}</p>
</td>
</tr>

{{#if pnr}}
<tr>
<td class="pad" style="padding:24px 32px 6px;">
  <div style="margin-bottom:10px;font-size:13px;color:#9aa8c7;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.pnr'}}</div>
  <!-- The memorable thing: the airline code as split-flap tiles. Without gradients the tiles stay flat and legible. -->
  <table role="presentation" dir="ltr" cellpadding="0" cellspacing="0" border="0" align="{{textStart}}">
  <tr>{{#each (chars pnr)}}{{> flap char=this}}{{/each}}</tr>
  </table>
</td>
</tr>
{{/if}}

<tr>
<td class="pad" style="padding:26px 32px 0;">
  <div style="padding-bottom:10px;font-size:18px;font-weight:800;color:#ffffff;text-align:{{textStart}};">{{t 'emails.design.board_title'}}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
  <tr>
    <td style="padding:8px 0;border-top:1px solid #39446e;border-bottom:1px solid #39446e;font-size:12px;color:#9aa8c7;text-align:{{textStart}};">{{t 'emails.design.col_time'}}</td>
    <td style="padding:8px 8px;border-top:1px solid #39446e;border-bottom:1px solid #39446e;font-size:12px;color:#9aa8c7;text-align:{{textStart}};">{{t 'emails.design.col_destination'}}</td>
    <td class="hide-m" style="padding:8px 8px;border-top:1px solid #39446e;border-bottom:1px solid #39446e;font-size:12px;color:#9aa8c7;text-align:{{textStart}};">{{t 'emails.design.col_flight'}}</td>
    <td style="padding:8px 0;border-top:1px solid #39446e;border-bottom:1px solid #39446e;font-size:12px;color:#9aa8c7;text-align:{{textEnd}};">{{t 'emails.design.col_status'}}</td>
  </tr>
  {{#each slices}}
  <tr>
    <td style="padding:14px 0;border-bottom:1px solid #232c4d;vertical-align:top;text-align:{{@root.textStart}};">
      <div dir="ltr" style="font-family:Consolas,Menlo,'Courier New',monospace;font-size:24px;font-weight:700;line-height:1.2;color:#ffc53d;text-align:{{@root.textStart}};">{{clock departingAt}}</div>
      <div style="margin-top:3px;font-size:12px;color:#c4cee3;">{{day departingAt}}</div>
    </td>
    <td style="padding:14px 8px;border-bottom:1px solid #232c4d;vertical-align:top;text-align:{{@root.textStart}};">
      <div class="dest" dir="ltr" style="font-family:Consolas,Menlo,'Courier New',monospace;font-size:28px;font-weight:700;line-height:1.1;color:#ffffff;text-align:{{@root.textStart}};">{{destination}}</div>
      <div style="margin-top:3px;font-size:12px;color:#c4cee3;">{{t 'emails.design.from_iata' iata=origin}}</div>
    </td>
    <td class="hide-m" dir="ltr" style="padding:14px 8px;border-bottom:1px solid #232c4d;vertical-align:top;font-family:Consolas,Menlo,'Courier New',monospace;font-size:16px;line-height:1.7;color:#ffffff;text-align:{{@root.textStart}};">{{#each flights}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</td>
    <td style="padding:14px 0;border-bottom:1px solid #232c4d;vertical-align:top;font-size:15px;font-weight:800;line-height:1.7;color:#ffc53d;text-align:{{@root.textEnd}};">{{t 'emails.design.status'}}</td>
  </tr>
  {{/each}}
  </table>
</td>
</tr>

<tr>
<td class="pad" style="padding:22px 32px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:0 0 12px;font-size:13px;line-height:1.5;color:#9aa8c7;vertical-align:top;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.reference'}}</td>
    <td dir="ltr" style="padding:0 0 12px;font-size:15px;font-weight:700;color:#ffffff;vertical-align:top;text-align:{{textEnd}};">{{reference}}</td>
  </tr>
  {{#if airline}}
  <tr>
    <td style="padding:0 0 12px;font-size:13px;line-height:1.5;color:#9aa8c7;vertical-align:top;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.airline'}}</td>
    <td style="padding:0 0 12px;font-size:15px;font-weight:700;color:#ffffff;vertical-align:top;text-align:{{textEnd}};">{{airline}}</td>
  </tr>
  {{/if}}
  <tr>
    <td style="padding:0 0 12px;font-size:13px;line-height:1.5;color:#9aa8c7;vertical-align:top;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.passengers'}}</td>
    <td dir="ltr" style="padding:0 0 12px;font-size:14px;line-height:1.6;font-weight:600;color:#ffffff;vertical-align:top;text-align:{{textEnd}};">{{#each passengers}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</td>
  </tr>
  {{#if amount}}
  <tr>
    <td style="padding:0 0 12px;font-size:13px;line-height:1.5;color:#9aa8c7;vertical-align:top;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.total'}}</td>
    <td dir="ltr" style="padding:0 0 12px;font-size:15px;font-weight:700;color:#ffffff;vertical-align:top;text-align:{{textEnd}};">{{amount}} {{currency}}</td>
  </tr>
  {{/if}}
  </table>
</td>
</tr>

<tr>
<td class="pad" style="padding:8px 32px 30px;">
  <p style="margin:0 0 18px;font-size:14px;line-height:1.7;color:#c4cee3;text-align:{{textStart}};">{{t 'emails.bookings.confirmed.ticket_soon'}}</p>
  {{> button url=link label=(t 'emails.bookings.confirmed.cta')}}
  {{> link_fallback url=link}}
  {{> signature}}
</td>
</tr>
</table>
