<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{subject}}</title>
<style>
@media (max-width:600px) {
  .pad { padding-left:20px !important; padding-right:20px !important; }
  .outer { padding:16px 10px !important; }
  .iata { font-size:40px !important; }
  .pnr { font-size:30px !important; }
  .col { display:block !important; width:100% !important; padding-bottom:16px !important; }
}
@media (prefers-color-scheme: dark) {
  .page, .notch { background-color:#0a0e21 !important; }
  .stub { background-color:#16213d !important; }
  .stub-text { color:#f1f5f9 !important; }
  .stub-muted { color:#a6b3c9 !important; }
  .note { background-color:#1f2d4d !important; color:#e2e8f0 !important; }
  .pnr { color:#4fd1d1 !important; }
  .foot { color:#a6b3c9 !important; }
  .foot a { color:#4fd1d1 !important; }
  .perf { border-color:#3a4a6b !important; }
  .link { color:#4fd1d1 !important; }
}
</style>
</head>
<body class="page" dir="{{dir}}" style="margin:0;padding:0;background-color:#dcebec;">
<div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#dcebec;">{{t 'emails.design.preheader'}}</div>
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#dcebec;">
<tr>
<td class="outer" align="center" style="padding:32px 16px;font-family:-apple-system,'Segoe UI',Tahoma,Roboto,Helvetica,Arial,'Noto Sans Arabic',sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
<tr><td>{{{body}}}</td></tr>
<tr>
<td class="foot pad" dir="{{dir}}" align="{{textStart}}" style="padding:24px 28px 8px;font-size:13px;line-height:1.7;color:#47606a;text-align:{{textStart}};">
<p style="margin:0 0 6px;">{{t 'emails.layout.support' supportEmail=supportEmail}}</p>
<p style="margin:0 0 6px;">{{t 'emails.layout.footer' siteName=siteName}}</p>
<p style="margin:0;">{{t 'emails.layout.rights' year=year siteName=siteName}}</p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
