diff --git a/dist/dto-CHeB-l1i.mjs b/dist/dto-CHeB-l1i.mjs
index 71150dbea8fed02a5f524d4db5c0193bd77f0e65..cbb436c942172e04f65faa786f96fb02004ba737 100644
--- a/dist/dto-CHeB-l1i.mjs
+++ b/dist/dto-CHeB-l1i.mjs
@@ -393,6 +393,14 @@ function cleanupRefs(rootSchema, io) {
 			if (defKey && io === "output") schema.$ref = `#/$defs/${defKey}_Output`;
 		}
 		if ("id" in schema) delete schema["id"];
+		// goteav patch: zod collapses a nullable/union of bare primitives into `type: ["string", "null"]`;
+		// @nestjs/swagger reads an array `type` as `isArray` and emits `array<string>`. Expand it into
+		// `anyOf` so the null branch is detected as 3.1 syntax and converted to `nullable: true`.
+		if (Array.isArray(schema.type)) {
+			const { type: types, ...rest } = schema;
+			if (types.length === 1) return { ...rest, type: types[0] };
+			return { ...rest, anyOf: types.map((type) => ({ type })) };
+		}
 		return schema;
 	}, { clone: true });
 }
