{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "description": "Hub: project operations room for teams that build with AI agents",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @hub/contracts build && pnpm --filter @hub/api --if-present prisma:generate",
    "prepare": "husky",
    "setup:env": "node scripts/first-run.mjs",
    "dev": "pnpm -r --parallel --filter @hub/contracts --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @hub/api test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm --filter @hub/api arch:check && pnpm test && pnpm --filter @hub/api openapi:export && pnpm --filter @hub/web api:check",
    "api:sync": "pnpm --filter @hub/api openapi:export && pnpm --filter @hub/web api:sync",
    "db:migrate": "pnpm --filter @hub/api prisma:migrate",
    "db:deploy": "pnpm --filter @hub/api prisma:deploy",
    "seed:owner": "pnpm --filter @hub/api seed:owner",
    "seed:sources": "pnpm --filter @hub/api seed:sources",
    "import:goteav": "pnpm --filter @hub/contracts build && pnpm --filter @hub/api import:goteav",
    "compose:up": "docker compose -f infra/compose.dev.yaml up -d",
    "compose:down": "docker compose -f infra/compose.dev.yaml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
