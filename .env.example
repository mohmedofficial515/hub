# Copy with `pnpm setup:env`, which fills HUB_SECRET_KEY and HUB_OWNER_PASSWORD with random values.
# The API and the Prisma CLI read this root file. Catalogue: docs/13-operations.md.

NODE_ENV=development
# How `pnpm start:local` and HubServer run Hub: `dev` from source, where a saved change shows at once (next dev, nest --watch,
# tsup --watch); `production` (or empty) from the build. The environment wins over this line for one run.
HUB_MODE=dev
PROCESS_ROLE=all
PORT=7310
LOG_LEVEL=info
HUB_PUBLIC_URL=http://localhost:7300
# Where another device reaches the API (/mcp, /bridge, the connect script). Empty: the host the browser used, on PORT.
HUB_API_PUBLIC_URL=
HUB_ALLOWED_HOSTS=localhost,127.0.0.1
# Publishing to your other devices through Tailscale (docs/16 §10, D43): `pnpm hub:tailscale serve` prints the two URLs to put above,
# both https://<this machine>.<tailnet>.ts.net. With an https HUB_PUBLIC_URL the cookies are Secure and the API and web listen on 127.0.0.1 only.
# HUB_BIND_HOST overrides that address.
HUB_BIND_HOST=

# Nightly backups (docs/16 D61 to D63). The folder, time and how many to keep are set in Settings › Backups. HUB_BACKUP_DIR is the
# default folder (empty: HubBackups at the root of this drive). Backups never contain this file or any secret.
HUB_BACKUP_DIR=
TZ=Europe/Istanbul

# infra/compose.dev.yaml
DATABASE_URL=postgresql://hub:hub@localhost:7340/hub?schema=public
REDIS_URL=redis://localhost:7341/0

# AES-256-GCM key, base64 of 32 bytes
HUB_SECRET_KEY=

# HS256 key of the access token and the TOTP challenge
HUB_JWT_SECRET=

# First owner. The email comes from the owner's environment, never from a committed file.
HUB_OWNER_EMAIL=
HUB_OWNER_PASSWORD=
HUB_OWNER_NAME=Owner

# Local path mode (docs/15 §3). The lab is apps/lab, served by Hub at /lab, so LAB_ROOT stays unset unless the lab lives elsewhere.
# LAB_PORT is the lab's own dev server on this machine (default 7320). LAB_WEB_SRC and LAB_DASH_SRC find the sibling projects
# (default ../../../web/src and ../../../Goteav-Dashboard/src, from apps/lab).
REPOS_ROOT=.tmp/repos

# Mail in development: Mailpit from compose.dev.yaml
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=7342
SMTP_SECURE=false
MAIL_FROM=Hub <hub@localhost>
